---
const { t, locale }=Astro.props;
---
<section class="section white"><div class="container"><div class="cta pattern"><img src="/images/cta-bg.webp" alt="" loading="lazy"/><div><i data-lucide="sparkles"></i><h2>{t.cta.title}</h2><p>{t.cta.desc}</p><a class="button" href={`/${locale}/apply`}>{t.cta.button}</a></div></div></div></section>
