---
const { t }=Astro.props;
---
<section id="faculty" class="section soft"><div class="container"><div class="section-head"><h2>{t.faculty.title}</h2><p>{t.faculty.subtitle}</p></div><div class="cards four faculty">{t.faculty.members.map(([name,role,img])=><article class="person"><img src={`/images/${img}`} alt={name} loading="lazy"/><h3>{name}</h3><p>{role}</p></article>)}</div></div></section>
